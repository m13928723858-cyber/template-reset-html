# Dolphin AI API Key (必需)
# 请在 https://dolphin-chat.ihippogame.com 获取您的 API Key
DOLPHIN_API_KEY=your_api_key_here
DOLPHIN_BASE_URL=https://dolphin-chat.ihippogame.com/api/v1

# 服务器配置
PORT=8000
HOST=0.0.0.0

# 文件配置
# 最大文件大小：100MB (单位：字节)
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# 爬虫配置
# 每个品牌爬取的图片数量
IMAGES_PER_BRAND=10
# 爬虫超时时间（秒）
CRAWL_TIMEOUT=30
# 最大并发下载数
MAX_CONCURRENT_DOWNLOADS=5

# 图片处理
# 图片质量 (1-100)
IMAGE_QUALITY=85
# 图片格式 (webp, jpg, png)
IMAGE_FORMAT=webp
# 最大图片尺寸（像素）
MAX_IMAGE_SIZE=2048
